{
  "name": "novelo",
  "version": "1.5.4",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "link": "npm link file:../../react-native-short-style/styled file:../../react-native-short-style/react-native-short-style-devtools --legacy-peer-deps",
    "parse": "node parsers/tsc/nodeParser.mjs",
    "zip": "npm run parse && npx bestzip ../parsers2.zip temp/parsers",
    "androidFiles": "node parsers/tsc/writeAndroidFiles.mjs",
    "update": "eas update --message [dbclick fix]",
    "clean": "cd android && (if exist app\\.cxx rmdir /s /q app\\.cxx) && gradlew --stop && gradlew clean",
    "gradlew": "npm run zip && cd android && gradlew app:assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "gradLewAll": "npm run zip && cd android && gradlew app:assembleRelease",
    "debugbuild": "cross-env NODE_ENV=development npm run zip && cd android && gradlew app:assembleDebug -PreactNativeArchitectures=arm64-v8a --info",
    "compile": "tsc ./parsers/ReadNovelFull.ts",
    "start": "expo start",
    "startC": "expo start -c",
    "clearDemo": "cd android && gradlew.bat --stop && gradlew clean",
    "android": "npx expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "eas build -p android --profile preview",
    "dev": "eas build -p android --profile development",
    "prod": "eas build -p android --profile production",
    "local": "turtle build:android",
    "js": "jsjoiner join -o /data/data/com.termux/files/home/Novelo/assets/index.ts -f '/storage/emulated/0/Documents/Projects/ContextMenu/*.js.css'",
    "check:circles": "madge ./ --circular",
    "connect": "adb connect 127.0.0.1:5555",
    "clearGrade": "cd D: && python \"cureppted files check.py\" \"C:\\Users\\alen\\.gradle\\caches.old\""
  },
  "codegenConfig": {
    "name": "EpubZipperSpec",
    "type": "modules",
    "jsSrcsDir": "./localModules",
    "android": {
      "javaPackageName": "com.alentoma.Novelo"
    }
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-background-actions",
          "react-native-network-info",
          "react-native-fs",
          "react-native-exit-app",
          "manage-external-storage",
          "react_native_sherpa_onnx_offline_tts",
          "rn-update-apk"
        ]
      }
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/material-top-tabs": "^7.4.18",
    "@react-navigation/native": "^7.1.25",
    "@react-navigation/native-stack": "^7.8.6",
    "@shopify/flash-list": "2.3.2",
    "advanced-html-parser": "^1.1.0",
    "compromise": "^14.15.0",
    "expo": "~58.0.24",
    "expo-asset": "~58.0.20",
    "expo-blob": "^58.0.3",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-keep-awake": "~58.0.3",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.9",
    "expo-screen-orientation": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.16",
    "expo-status-bar": "~58.0.5",
    "js-base64": "^3.7.8",
    "jszip": "^3.10.2",
    "manage-external-storage": "^0.1.3",
    "react": "19.3.0",
    "react_native_sherpa_onnx_offline_tts": "git+https://github.com/1-AlenToma/react-native-sherpa-onnx-offline-tts.git",
    "react-native": "0.88.1",
    "react-native-background-actions": "^4.0.1",
    "react-native-config": "^1.6.1",
    "react-native-device-info": "^15.0.2",
    "react-native-exit-app": "^2.0.0",
    "react-native-fs": "^2.20.0",
    "react-native-fs-turbo": "^0.5.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-network-info": "^5.2.2",
    "react-native-nitro-http-server": "^1.10.0",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-short-style": "^1.4.4",
    "react-native-svg": "15.16.0",
    "react-native-translator": "^2.0.0",
    "react-native-ts-sqlite-orm": "^0.2.0",
    "react-native-uuid": "^2.0.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-native-zip-archive": "^7.0.2",
    "react-smart-state": "^1.1.5",
