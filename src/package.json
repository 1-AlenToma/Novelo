    "@types/react": "^19.3.0",
    "babel-preset-expo": "^58.0.24",
    "baseline-browser-mapping": "^2.9.5",
    "bestzip": "^4.0.3",
    "cross-env": "^10.1.0",
    "expo-dev-client": "~58.0.19",
    "react-native-codegen": "^0.70.7",
    "typescript": "~6.0.3"
  },
  "private": true,
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "react-native-nitro-http-server@1.10.0": true
  }
}
